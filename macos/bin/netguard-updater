#!/bin/sh
# Root-owned entry for the automatic updater (com.netguard.updater). No caller-chosen code.
ROOT=/Library/NetGuard
PY=$(/bin/cat "$ROOT/python-path" 2>/dev/null)
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
    PY=/usr/bin/python3
fi
cd /
exec "$PY" -I -B -c 'import sys; sys.path.insert(0, "/Library/NetGuard/lib"); from netguard import updater; sys.exit(updater.main())' "$@"
